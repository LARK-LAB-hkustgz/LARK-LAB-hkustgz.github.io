---
layout: default
---
<div class="post blog-index">
  <header class="post-header">
    <h1 class="post-title">{{ page.title }}</h1>
    <p class="post-description">{{ site.blog_description }}</p>
  </header>

  {{ content }}

  {% assign posts = site.posts | sort: 'date' | reverse %}
  <div class="blog-list">
    {% for post in posts %}
      <article class="blog-card">
        {% if post.cover %}
          <a class="blog-card-cover" href="{{ post.url | relative_url }}" aria-label="{{ post.title | escape }}">
            <img src="{{ post.cover | relative_url }}" alt="{{ post.cover_alt | default: post.title | escape }}" loading="lazy">
          </a>
        {% endif %}
        <div class="blog-card-body">
          <p class="post-meta">
            <time datetime="{{ post.date | date_to_xmlschema }}">{{ post.date | date: '%B %d, %Y' }}</time>
            {% if post.author %} &middot; {{ post.author | escape }}{% endif %}
          </p>
          <h2>
            <a href="{{ post.url | relative_url }}">{{ post.title }}</a>
          </h2>
          <p>{{ post.description }}</p>
          {% if post.tags.size > 0 %}
            <div class="blog-card-tags">
              {% for tag in post.tags %}
                <a href="{{ tag | slugify | prepend: '/blog/tag/' | append: '/' | relative_url }}">#{{ tag }}</a>
              {% endfor %}
            </div>
          {% endif %}
          <div class="blog-card-links">
            <a href="{{ post.url | relative_url }}">Read article &rarr;</a>
            {% for translation in post.translations %}
              {% unless translation.lang == post.lang %}
                <a href="{{ translation.url | relative_url }}" lang="{{ translation.lang }}" hreflang="{{ translation.lang }}">
                  {{ translation.label }}
                </a>
              {% endunless %}
            {% endfor %}
          </div>
        </div>
      </article>
    {% else %}
      <p>No posts yet. Check back soon.</p>
    {% endfor %}
  </div>
</div>
